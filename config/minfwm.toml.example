# Copy to ~/.config/minfwm/minfwm.toml and run minfwm reload.

# Defaults used when an option is omitted:
# enable-window-shadows = false
# overscan-buffer-px = 500
# whitelist = ["Terminal", "Music"]
# spawn-behavior = "center"
# invert-zoom-scroll-direction = false
# rewind-on-focus = true
# center-on-cmd-tab = true
# zoomed-esc-center = "screen"
# camera.mouse-movement-multiplier = 1.0
# camera.trackpad-movement-multiplier = 1.0
# camera.trackpad-invert-x = false
# camera.trackpad-invert-y = false
# multi-display-mode = "isolated"
# pins.always-on-top = true
# animations.enable = true
# animations.speed = 1.0

[window]
enable-window-shadows = false
overscan-buffer-px = 500
whitelist = ["Terminal", "Music"]
spawn-behavior = "center"

[zoom]
# Reverse Super wheel zoom without changing ordinary application scrolling.
invert-zoom-scroll-direction = false
# Reverse four-finger trackpad pinch zoom independently of wheel zoom.
track-invert-zoom-direction = false
# Return the camera to a focused application after it is activated.
rewind-on-focus = true
# Escape anchor while zoomed: "screen", "mouse", or "focus".
zoomed-esc-center = "screen"

[camera]
# Center the camera on the active app's focused window after Cmd+Tab.
center-on-cmd-tab = true
# Scale camera panning relative to cursor movement. 2.0 is twice as fast; 0.5 is half speed.
mouse-movement-multiplier = 1.0
# Scale camera panning while moving three fingers on the trackpad.
trackpad-movement-multiplier = 1.0
# Reverse the corresponding trackpad pan axes when needed.
trackpad-invert-x = false
trackpad-invert-y = false

[display]
multi-display-mode = "isolated"

[pins]
always-on-top = true

[animations]
# Enable or disable camera, zoom, and window movement animations.
enable = true
# Animation speed multiplier: 2.0 is twice as fast; 0.5 is half speed (range 0.1–10).
speed = 1.0

[keybinds]
# Modifier names: "Cmd", "Alt", "Shift", "Ctrl". Defaults to ["Cmd", "Alt"].
# Super + left-drag pans; Super + vertical-scroll zooms.
# Example: super = ["Ctrl", "Alt"]
# Super+1..9 saves a bookmark; Super+Shift+1..9 returns to it.
# Super+P pins/unpins the focused window; Escape exits overview.
# Super+F centers the camera on the focused window; Super+S centers the window in the camera.
super = ["Cmd", "Alt"]
center-camera-to-focus = ["Super", "F"]
center-focus-to-camera = ["Super", "S"]
drag-everywhere = ["Super", "Ctrl"]
bookmarks-add = ["Super"]
bookmarks-goto = ["Super", "Shift"]
