# Copy to ~/.config/minfwm/minfwm.toml and run minfwm reload.

# Defaults used when an option is omitted:
# enable-window-shadows = false
# overscan-buffer-px = 500
# whitelist = ["Terminal", "Music"]
# spawn-behavior = "center"
# invert-zoom-scroll-direction = false
# zoomed-esc-center = "screen"
# multi-display-mode = "isolated"
# pins.always-on-top = true

[window]
enable-window-shadows = false
overscan-buffer-px = 500
whitelist = ["Terminal", "Music"]
spawn-behavior = "center"

[zoom]
# Reverse Super wheel zoom without changing ordinary application scrolling.
invert-zoom-scroll-direction = false
# Escape anchor while zoomed: "screen", "mouse", or "focus".
zoomed-esc-center = "screen"

[display]
multi-display-mode = "isolated"

[pins]
always-on-top = true

[keybinds]
# Modifier names: "Cmd", "Alt", "Shift", "Ctrl". Defaults to ["Cmd", "Alt"].
# Super + left-drag pans; Super + vertical-scroll zooms.
# Example: super = ["Ctrl", "Alt"]
# Cmd+1..9 loads a bookmark; Cmd+Shift+1..9 saves it.
# Super+P pins/unpins the focused window; Escape exits overview.
# Super+F centers the camera on the focused window; Super+S centers the window in the camera.
super = ["Cmd", "Alt"]
center-camera-to-focus = ["Super", "F"]
center-focus-to-camera = ["Super", "S"]
